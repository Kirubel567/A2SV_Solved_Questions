n, k = map(int, input().split())
lst = list(map(int, input().split()))
 
#first create the diff arr
gaps = [lst[i]-lst[i-1] for i in range(1, len(lst))]
#sort the gaps arr to get the largest (to remve them from the partition) gaps to remove
gaps.sort()
 
#this is the total gap, to split means 
total_gap = lst[n-1] - lst[0]
for i in range(k-1): 
    total_gap -= gaps[-i-1]
 
print(total_gap)
