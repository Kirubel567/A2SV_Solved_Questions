n, m = map(int, (input().split()))
arr1 = list(map(int, input().split()))
arr2 = list(map(int, input().split()))
 
i = j = ans = 0
while i < n and j < m: 
    if arr1[i] < arr2[j]: 
        i += 1
    elif arr1[i] > arr2[j]: 
        j += 1
    else: 
        value = arr1[i]
        a=b=0
        
        while i < len(arr1) and arr1[i] == value:
            a += 1
            i += 1
        while j < len(arr2) and arr2[j] == value: 
            b+=1
            j += 1
        
        ans += a*b
print(ans)
